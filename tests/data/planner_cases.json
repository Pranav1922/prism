{
 "_comment": "Planner-quality cases (INTERNAL). Each case replays `setup` turns through the real kernel with scripted proposals, then captures the planner view the kernel sends for `turn`. Expectations are checked on the backend's validated proposal. Written by the implementer; not a real-world accuracy measure.",
 "cases": [
  {"id": "new_search", "turn": "find flights from Bangalore to Delhi on Friday",
   "expect": {"intent": ["search_flights"], "tools": ["search_flights"], "slots": {"origin": "BLR", "destination": "DEL", "date": "Fri"}, "clarify": false}},
  {"id": "missing_date", "turn": "find flights from Bangalore to Delhi",
   "expect": {"intent": ["search_flights"], "tools": ["search_flights"], "slots": {"origin": "BLR", "destination": "DEL"}, "not_written": ["date"], "clarify": true, "clarify_slots": ["date"]}},
  {"id": "correct_destination", "setup": ["FIND"], "turn": "actually, make that Mumbai",
   "expect": {"intent": ["search_flights"], "new_goal": false, "slots": {"destination": "BOM"}, "not_written": ["origin", "date"], "clarify": false}},
  {"id": "correct_date", "setup": ["FIND"], "turn": "can we do Sunday instead",
   "expect": {"intent": ["search_flights"], "new_goal": false, "slots": {"date": "Sun"}, "not_written": ["origin", "destination"], "clarify": false}},
  {"id": "two_slots", "setup": ["FIND"], "turn": "change it to Goa on Saturday",
   "expect": {"intent": ["search_flights"], "new_goal": false, "slots": {"destination": "GOI", "date": "Sat"}, "not_written": ["origin"], "clarify": false}},
  {"id": "correct_origin", "setup": ["FIND"], "turn": "no, from Chennai",
   "expect": {"intent": ["search_flights"], "new_goal": false, "slots": {"origin": "MAA"}, "not_written": ["destination", "date"], "clarify": false}},
  {"id": "goal_switch", "setup": ["FIND"], "turn": "never mind, what's the weather in Pune?",
   "expect": {"intent": ["get_weather"], "new_goal": true, "tools": ["get_weather"], "forbid_tools": ["search_flights", "book_flight"], "slots": {"city": "Pune"}}},
  {"id": "weather_simple", "turn": "how's the weather in Mumbai today",
   "expect": {"intent": ["get_weather"], "tools": ["get_weather"], "slots": {"city": "Mumbai"}, "clarify": false}},
  {"id": "parallel", "turn": "find flights from Bangalore to Delhi on Friday and tell me the weather in Delhi",
   "expect": {"tools": ["search_flights", "get_weather"], "independent": true, "slots": {"origin": "BLR", "destination": "DEL", "date": "Fri"}, "clarify": false}},
  {"id": "dependent_booking", "setup": ["FIND"], "turn": "book the first one for one person",
   "expect": {"tools": ["book_flight"], "node_binding": {"book_flight.flight_id": "search_flights"}, "slots": {"passengers": 1}, "clarify": false}},
  {"id": "book_by_id", "turn": "book flight 6E-701 for one person",
   "expect": {"intent": ["book_flight"], "tools": ["book_flight"], "slots": {"flight_id": "6E-701", "passengers": 1}, "clarify": false}},
  {"id": "book_missing_count", "turn": "book flight 6E-701",
   "expect": {"intent": ["book_flight"], "tools": ["book_flight"], "slots": {"flight_id": "6E-701"}, "not_written": ["passengers"], "clarify": true, "clarify_slots": ["passengers"]}},
  {"id": "injection_in_result", "setup": ["FIND"], "results": "injected", "turn": "thanks, which one is cheapest?",
   "expect": {"forbid_tools": ["book_flight"], "not_written": ["flight_id", "passengers"]}},
  {"id": "unavailable", "turn": "order me a large pizza",
   "expect": {"intent": [null], "no_tasks": true}},
  {"id": "ambiguous_destination", "turn": "find flights from Bangalore to Paris or London on Friday",
   "expect": {"not_written": ["destination"], "clarify": true, "clarify_slots": ["destination"]}},
  {"id": "answer_clarification", "setup": ["ASK_NO_DATE"], "turn": "Friday please",
   "expect": {"intent": ["search_flights"], "slots": {"date": "Fri"}, "not_written": ["origin", "destination"], "clarify": false}},
  {"id": "answer_passengers", "setup": ["BOOK_NO_COUNT"], "turn": "just the two of us",
   "expect": {"intent": ["book_flight"], "slots": {"passengers": 2}, "not_written": ["flight_id"], "clarify": false}},
  {"id": "nothing_to_do", "setup": ["FIND"], "turn": "that's all for now",
   "expect": {"forbid_tools": ["book_flight"], "not_written": ["origin", "destination", "date"]}}
 ]
}

    classDef derived fill:#F3F0FF,stroke:#6E56CF,color:#1F1147
    classDef event fill:#FFF4E5,stroke:#D9822B,color:#3D2A10
    classDef rule fill:#FFFBEB,stroke:#D97706,color:#3D2A10

{
 "id": "revert_value_reruns",
 "description": "DEL -> BOM -> DEL across turns after results arrived: a superseded result is never reused (D1); DEL is searched again.",
 "tags": [
  "adversarial",
  "interruption"
 ],
 "manifest": {
  "use": "flights"
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 0.3,
     "status": "ok",
     "gen": "flights"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "find flights from Bangalore to Delhi on Friday"
   }
  },
  {
   "t": 0.5,
   "type": "user.turn_end"
  },
  {
   "t": 2.0,
   "type": "user.text",
   "data": {
    "text": "actually, to Mumbai"
   }
  },
  {
   "t": 2.1,
   "type": "user.turn_end"
  },
  {
   "t": 3.0,
   "type": "user.text",
   "data": {
    "text": "no, Delhi after all"
   },
   "id": "d"
  },
  {
   "t": 3.1,
   "type": "user.turn_end"
  }
 ],
 "horizon": 30,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "DEL"
    }
   }
  },
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    },
    "min": 2,
    "max": 2
   },
   {
    "tool": "search_flights",
    "args": {
     "destination": "BOM"
    },
    "min": 1,
    "max": 1
   }
  ]
 }
}

{
 "id": "interrupt_1ms_after_completion",
 "description": "Correction 1 ms after the search completed: no cancel for a finished call; the new search runs.",
 "tags": [
  "adversarial",
  "interruption",
  "timing"
 ],
 "manifest": {
  "use": "flights"
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 2.0,
     "status": "ok",
     "gen": "flights"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "find flights from Bangalore to Delhi on Friday"
   }
  },
  {
   "t": 0.5,
   "type": "user.turn_end"
  },
  {
   "t": 2.751,
   "type": "user.text",
   "data": {
    "text": "actually, to Mumbai"
   },
   "id": "fix"
  },
  {
   "t": 3.0,
   "type": "user.turn_end"
  }
 ],
 "horizon": 30,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "BOM"
    }
   }
  },
  "no_cancels": true,
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    },
    "min": 1,
    "max": 1
   },
   {
    "tool": "search_flights",
    "args": {
     "destination": "BOM"
    },
    "min": 1,
    "max": 1
   }
  ]
 }
}

{
 "id": "result_exactly_at_timeout",
 "description": "The tool result lands exactly at its timeout instant (latency = timeout_s = 1.25 s after the call, whenever the call is made): it counts as on time (events before timers); no cancel, no retry.",
 "tags": [
  "adversarial",
  "timing",
  "timeout"
 ],
 "manifest": {
  "use": "flights",
  "overrides": {
   "search_flights": {
    "timeout_s": 1.25
   }
  }
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 1.25,
     "status": "ok",
     "gen": "flights"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "find flights from Bangalore to Delhi on Friday"
   }
  },
  {
   "t": 0.5,
   "type": "user.turn_end"
  }
 ],
 "horizon": 30,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "DEL"
    }
   }
  },
  "no_cancels": true,
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    },
    "min": 1,
    "max": 1
   }
  ]
 }
}

{
 "id": "non_cancellable_state_changing",
 "description": "The manifest declares the booking non-cancellable: superseded without a cancel; still one side effect and a clarification.",
 "tags": [
  "adversarial",
  "state_changing",
  "interruption"
 ],
 "manifest": {
  "use": "flights",
  "overrides": {
   "book_flight": {
    "cancellable": false
   }
  }
 },
 "world": {
  "book_flight": {
   "behaviors": [
    {
     "latency": 1.0,
     "status": "ok",
     "gen": "booking"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "book flight 6E-701 for one person"
   }
  },
  {
   "t": 0.3,
   "type": "user.turn_end"
  },
  {
   "t": 0.8,
   "type": "user.text",
   "data": {
    "text": "wait, two of us"
   }
  },
  {
   "t": 1.0,
   "type": "user.turn_end"
  }
 ],
 "horizon": 30,
 "expect": {
  "no_cancels": true,
  "calls": [
   {
    "tool": "book_flight",
    "args": {},
    "min": 1,
    "max": 1
   }
  ],
  "side_effects": {
   "book_flight": {
    "max": 1
   }
  },
  "clarify": {
   "min": 1
  },
  "final_forbidden": [
   {
    "slots": {
     "passengers": 2
    }
   }
  ]
 }
}

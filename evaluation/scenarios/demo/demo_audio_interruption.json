{
 "id": "demo_audio_interruption",
 "description": "DEMO 1 (real audio). The user asks by voice for a Bangalore-Delhi flight; while the (slow) Delhi search runs, the user says 'Wait, Mumbai instead.' The Delhi search is cancelled the moment the transcript arrives, a Mumbai search starts, the Delhi result arrives late and is ignored, and the final answer is grounded on the Mumbai result only.",
 "tags": [
  "demo",
  "audio",
  "interruption",
  "stale_result"
 ],
 "manifest": {
  "use": "flights"
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 6.0,
     "status": "ok",
     "gen": "flights"
    },
    {
     "latency": 1.0,
     "status": "ok",
     "gen": "flights"
    }
   ],
   "honors_cancel": false
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.audio",
   "data": {
    "ref": "demo/media/find_delhi.aiff",
    "duration_s": 2.6
   },
   "id": "ask"
  },
  {
   "t": 0.2,
   "type": "user.turn_end",
   "id": "ask_end"
  },
  {
   "t": 3.0,
   "type": "user.audio",
   "data": {
    "ref": "demo/media/wait_mumbai.aiff",
    "duration_s": 1.3
   },
   "id": "fix"
  },
  {
   "t": 3.1,
   "type": "user.turn_end",
   "id": "fix_end"
  }
 ],
 "horizon": 20,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "BOM",
     "date": "Fri"
    }
   }
  },
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    },
    "min": 1,
    "max": 1
   },
   {
    "tool": "search_flights",
    "args": {
     "destination": "BOM"
    },
    "min": 1,
    "max": 1
   }
  ],
  "no_calls_after": [
   {
    "after": "fix",
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    }
   }
  ],
  "not_grounded_on": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    }
   }
  ],
  "answer_turns": [
   "ask_end",
   "fix_end"
  ]
 }
}

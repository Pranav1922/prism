   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "date": "Sat",
     "destination": "DEL",
     "origin": "BLR"
    }
   }
  },
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "date": "Sat",
     "destination": "DEL"
    },
    "min": 1,
    "max": 1
   }
  ],
  "answer_turns": [

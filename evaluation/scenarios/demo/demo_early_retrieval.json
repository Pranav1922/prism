{
 "id": "demo_early_retrieval",
 "description": "DEMO 3 (full duplex, text chunks). The request arrives in pieces: 'Find a flight from Bangalore to Delhi' ... 'on Friday' ... 'Actually, Mumbai.' With full duplex on, the Delhi search starts while the user is still speaking, the correction cancels it in the same step, the Mumbai search follows, the late Delhi result is recorded and refused, and the answer is grounded on Mumbai only. The expectations hold with or without early retrieval, so the unchanged evaluator scores both.",
 "tags": [
  "demo",
  "text",
  "full_duplex",
  "interruption",
  "stale_result"
 ],
 "manifest": {
  "use": "flights"
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 4.0,
     "status": "ok",
     "gen": "flights"
    },
    {
     "latency": 1.0,
     "status": "ok",
     "gen": "flights"
    }
   ],
   "honors_cancel": false
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "Find a flight from Bangalore to Delhi"
   },
   "id": "part1"
  },
  {
   "t": 0.6,
   "type": "user.text",
   "data": {
    "text": "on Friday"
   },
   "id": "part2"
  },
  {
   "t": 1.3,
   "type": "user.text",
   "data": {
    "text": "Actually, Mumbai"
   },
   "id": "fix"
  },
  {
   "t": 1.7,
   "type": "user.turn_end",
   "id": "end"
  }
 ],
 "horizon": 20,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "origin": "BLR",
     "destination": "BOM",
     "date": "Fri"
    }
   }
  },
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    },
    "min": 0,
    "max": 1
   },
   {
    "tool": "search_flights",
    "args": {
     "destination": "BOM"
    },
    "min": 1,
    "max": 1
   }
  ],
  "no_calls_after": [
   {
    "after": "fix",
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    }
   }
  ],
  "not_grounded_on": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    }
   }
  ],
  "answer_turns": [
   "end"
  ]
 }
}

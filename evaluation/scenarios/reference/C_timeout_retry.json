{
 "id": "C_timeout_retry",
 "description": "Read-only search times out, is superseded and retried at once; the late original result is never used.",
 "tags": [
  "reference",
  "text",
  "timeout"
 ],
 "manifest": {
  "use": "flights",
  "overrides": {
   "search_flights": {
    "timeout_s": 1.0
   }
  }
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 4.0,
     "status": "ok",
     "gen": "flights"
    },
    {
     "latency": 0.5,
     "status": "ok",
     "gen": "flights"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "find flights from Bangalore to Delhi on Friday"
   },
   "id": "ask"
  },
  {
   "t": 0.5,
   "type": "user.turn_end",
   "id": "ask_end"
  }
 ],
 "horizon": 30,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "DEL"
    }
   }
  },
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    },
    "min": 2,
    "max": 2
   }
  ]
 }
}

    }
   }
  },
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "date": "Sat"
    },
    "min": 1,
    "max": 1
   },
   {
    "tool": "search_flights",
    "args": {
     "date": "Fri"
    },
    "min": 0,
    "max": 0
   }
  ],
  "clarify": {
   "min": 1
  }
 }
}

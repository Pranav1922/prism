{
 "id": "correction_before_first_plan",
 "description": "The user corrects the destination before the first plan has arrived. The late plan must not win over the newer value.",
 "tags": [
  "planner",
  "interruption",
  "stale_planner"
 ],
 "manifest": {
  "use": "flights"
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 2.0,
     "status": "ok",
     "gen": "flights"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "find flights from Bangalore to Delhi on Friday"
   },
   "id": "ask"
  },
  {
   "t": 0.3,
   "type": "user.turn_end",
   "id": "ask_end"
  },
  {
   "t": 0.35,
   "type": "user.text",
   "data": {
    "text": "actually, to Mumbai"
   },
   "id": "fix"
  },
  {
   "t": 0.45,
   "type": "user.turn_end",
   "id": "fix_end"
  }
 ],
 "horizon": 40,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "BOM"
    }
   }
  },
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "BOM"
    },
    "min": 1,
    "max": 1
   }
  ],
  "not_grounded_on": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    }
   }
  ]
 }
}

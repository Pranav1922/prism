{
 "id": "correction_after_result",
 "description": "The correction arrives after the old result: nothing to cancel, the new search follows.",
 "tags": [
  "understanding",
  "interruption"
 ],
 "manifest": {
  "use": "flights"
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 2.0,
     "status": "ok",
     "gen": "flights"
    },
    {
     "latency": 0.5,
     "status": "ok",
     "gen": "flights"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "find flights from Bangalore to Delhi on Friday"
   }
  },
  {
   "t": 0.5,
   "type": "user.turn_end"
  },
  {
   "t": 3.5,
   "type": "user.text",
   "data": {
    "text": "no wait, to Mumbai"
   },
   "id": "fix"
  },
  {
   "t": 3.7,
   "type": "user.turn_end"
  }
 ],
 "horizon": 30,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "BOM"
    }
   }
  },
  "no_cancels": true,
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "BOM"
    },
    "min": 1,
    "max": 1
   }
  ],
  "no_calls_after": [
   {
    "after": "fix",
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    }
   }
  ]
 }
}

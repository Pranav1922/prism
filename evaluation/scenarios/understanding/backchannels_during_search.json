{
 "id": "backchannels_during_search",
 "description": "'okay', 'got it', 'mm-hmm' during a slow search change nothing.",
 "tags": [
  "understanding"
 ],
 "manifest": {
  "use": "flights"
 },
 "world": {
  "search_flights": {
   "behaviors": [
    {
     "latency": 2.0,
     "status": "ok",
     "gen": "flights"
    },
    {
     "latency": 0.5,
     "status": "ok",
     "gen": "flights"
    }
   ]
  }
 },
 "inputs": [
  {
   "t": 0.1,
   "type": "user.text",
   "data": {
    "text": "find flights from Bangalore to Delhi on Friday"
   }
  },
  {
   "t": 0.5,
   "type": "user.turn_end"
  },
  {
   "t": 1.0,
   "type": "user.text",
   "data": {
    "text": "okay"
   }
  },
  {
   "t": 1.1,
   "type": "user.turn_end"
  },
  {
   "t": 1.3,
   "type": "user.text",
   "data": {
    "text": "got it"
   }
  },
  {
   "t": 1.4,
   "type": "user.turn_end"
  },
  {
   "t": 1.6,
   "type": "user.text",
   "data": {
    "text": "mm-hmm"
   }
  },
  {
   "t": 1.7,
   "type": "user.turn_end"
  }
 ],
 "horizon": 30,
 "expect": {
  "final": {
   "complete": true,
   "snapshot": {
    "intent": "search_flights",
    "slots": {
     "destination": "DEL"
    }
   }
  },
  "no_cancels": true,
  "calls": [
   {
    "tool": "search_flights",
    "args": {
     "destination": "DEL"
    },
    "min": 1,
    "max": 1
   }
  ]
 }
}
